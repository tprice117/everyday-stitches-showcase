# Copy this file to `.env` and fill in real values. Never commit the real `.env`.

# ── Django ───────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ── Database (PostgreSQL) ────────────────────────────────────────────────
# The app maps onto an existing schema (models are managed=False), so the
# target database is expected to already have the tables.
DB_NAME=postgres
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# ── sales-sync: WooCommerce (see sales-sync/README.md) ───────────────────
# CHANNEL is only the fallback; per-order retail/wholesale is auto-detected.
SALES_SYNC_WOO_SITE_URL=https://your-store.example.com
SALES_SYNC_WOO_CONSUMER_KEY=ck_your_key
SALES_SYNC_WOO_CONSUMER_SECRET=cs_your_secret
SALES_SYNC_WOO_CHANNEL=R
